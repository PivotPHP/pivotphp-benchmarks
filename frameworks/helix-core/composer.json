{
    "name": "helixphp-benchmarks/helix-core",
    "description": "HelixPHP Core benchmark application (without ORM)",
    "type": "project",
    "require": {
        "php": "^8.1",
        "helixphp/core": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}