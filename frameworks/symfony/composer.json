{
    "name": "helixphp-benchmarks/symfony",
    "description": "Symfony benchmark application",
    "type": "project",
    "require": {
        "php": "^8.1",
        "symfony/framework-bundle": "^6.0",
        "symfony/runtime": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}