{
    "name": "pivotphp-benchmarks/pivotphp-core",
    "description": "PivotPHP Core benchmark application (without ORM)",
    "type": "project",
    "require": {
        "php": "^8.1",
        "pivotphp/core": "^1.1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
