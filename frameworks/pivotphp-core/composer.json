{
    "name": "pivotphp-benchmarks/pivotphp-core",
    "description": "PivotPHP Core benchmark application (without ORM)",
    "type": "project",
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.9",
        "monolog/monolog": "^3.0",
        "pivotphp/core": "^1.1.1",
        "vlucas/phpdotenv": "^5.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
