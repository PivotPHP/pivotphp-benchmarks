{
    "name": "pivotphp-benchmarks/pivotphp-reactphp",
    "description": "PivotPHP ReactPHP benchmark application (continuous runtime)",
    "type": "project",
    "require": {
        "php": "^8.1",
        "pivotphp/core": "^1.1.0",
        "pivotphp/reactphp": "^0.1.0",
        "guzzlehttp/guzzle": "^7.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "serve": "php server.php",
        "serve:background": "php server.php > /dev/null 2>&1 &",
        "benchmark": "php benchmarks/run.php",
        "benchmark:routing": "php benchmarks/routing.php",
        "benchmark:http": "php benchmarks/http-server.php",
        "benchmark:async": "php benchmarks/async-performance.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}