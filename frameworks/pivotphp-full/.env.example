# PivotPHP Full Stack Environment Configuration

APP_NAME="PivotPHP Full Stack"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080

# Database Configuration (ORM)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=pivotphp_full
DB_USERNAME=pivotphp
DB_PASSWORD=secret

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ReactPHP Configuration
REACT_HOST=0.0.0.0
REACT_PORT=8080
REACT_WORKERS=4

# Cache Configuration
CACHE_DRIVER=redis
CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=3600

# Logging
LOG_LEVEL=error
LOG_CHANNEL=stderr

# Performance Settings
OPCACHE_ENABLE=1
OPCACHE_JIT=1255
MEMORY_LIMIT=1G