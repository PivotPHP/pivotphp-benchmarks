# Makefile para PivotPHP v1.2.0 Benchmarks
# "Simplicidade sobre Otimização Prematura" Edition
# Ambiente Docker reimaginado para testes de performance

.PHONY: help build up down clean test benchmark validate logs shell openapi

# Configurações
COMPOSE_FILE = docker-compose-v120.yml
PIVOTPHP_VERSION = 1.2.0
BENCHMARK_ITERATIONS = 10000
PHILOSOPHY = "Simplicidade sobre Otimização Prematura"

# === COMANDOS PRINCIPAIS ===

help: ## Mostra ajuda dos comandos disponíveis v1.2.0
	@echo "🚀 PivotPHP v1.2.0 Benchmark Environment"
	@echo "========================================"
	@echo "Philosophy: $(PHILOSOPHY)"
	@echo "Edition: Reimagined Architecture"
	@echo ""
	@echo "Comandos disponíveis:"
	@echo ""
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-30s\033[0m %s\n", $$1, $$2}'

build: ## Constrói todas as imagens Docker v1.2.0 com recursos reimaginados
	@echo "🔨 Construindo imagens Docker para PivotPHP v$(PIVOTPHP_VERSION)..."
	@echo "Philosophy: $(PHILOSOPHY)"
	docker-compose -f $(COMPOSE_FILE) build --parallel
	@echo "✅ Imagens v1.2.0 construídas com sucesso!"

up: ## Inicia todos os containers v1.2.0
	@echo "🚀 Iniciando ambiente PivotPHP v$(PIVOTPHP_VERSION)..."
	@echo "NEW Features: OpenAPI, Swagger UI, Simplified Architecture"
	docker-compose -f $(COMPOSE_FILE) up -d
	@echo "⏳ Aguardando containers ficarem prontos..."
	@sleep 20
	@echo "✅ Ambiente v1.2.0 iniciado!"
	@make status

down: ## Para todos os containers v1.2.0
	@echo "🛑 Parando ambiente PivotPHP v$(PIVOTPHP_VERSION)..."
	docker-compose -f $(COMPOSE_FILE) down
	@echo "✅ Ambiente v1.2.0 parado!"

restart: ## Reinicia todos os containers v1.2.0
	@echo "🔄 Reiniciando ambiente v1.2.0..."
	@make down
	@make up

clean: ## Remove containers, volumes e imagens v1.2.0
	@echo "🧹 Limpando ambiente PivotPHP v$(PIVOTPHP_VERSION)..."
	docker-compose -f $(COMPOSE_FILE) down -v --remove-orphans
	docker system prune -f
	@echo "✅ Ambiente v1.2.0 limpo!"

# === VALIDAÇÃO E STATUS ===

validate: ## Valida configuração do docker-compose v1.2.0
	@echo "🔍 Validando configuração v1.2.0..."
	docker-compose -f $(COMPOSE_FILE) config
	@echo "✅ Configuração v1.2.0 válida!"

status: ## Mostra status dos containers v1.2.0
	@echo "📊 Status dos containers PivotPHP v$(PIVOTPHP_VERSION):"
	docker-compose -f $(COMPOSE_FILE) ps

health: ## Verifica saúde dos containers v1.2.0
	@echo "🏥 Verificando saúde dos containers v1.2.0..."
	@echo "Core v1.2.0:"
	@curl -f http://localhost:8080/health || echo "❌ Core v1.2.0 não responsivo"
	@echo ""
	@echo "ORM v1.2.0:"
	@curl -f http://localhost:8081/health || echo "❌ ORM v1.2.0 não responsivo"
	@echo ""
	@echo "ReactPHP v1.2.0:"
	@curl -f http://localhost:8082/health || echo "❌ ReactPHP v1.2.0 não responsivo"
	@echo ""

# === TESTES E BENCHMARKS ===

test: ## Executa todos os testes v1.2.0
	@echo "🧪 Executando testes PivotPHP v$(PIVOTPHP_VERSION)..."
	@make phase1-test
	@make phase2-test
	@make phase3-test
	@make openapi-test

benchmark-all: ## Executa todos os benchmarks v1.2.0
	@echo "📊 Executando benchmarks PivotPHP v$(PIVOTPHP_VERSION)..."
	@make benchmark-core
	@make benchmark-openapi
	@make benchmark-simplicity
	@make benchmark-legacy

benchmark-core: ## Benchmark PivotPHP Core v1.2.0 (Simplified)
	@echo "⚡ Benchmarking PivotPHP Core v$(PIVOTPHP_VERSION)..."
	php simple_benchmark_v120.php $(BENCHMARK_ITERATIONS)

benchmark-openapi: ## Benchmark OpenAPI features v1.2.0 (NEW!)
	@echo "🚀 Benchmarking OpenAPI v$(PIVOTPHP_VERSION) (NEW FLAGSHIP FEATURE)..."
	php openapi_benchmark_v120.php $(BENCHMARK_ITERATIONS)

benchmark-simplicity: ## Benchmark Simple vs Complex implementations
	@echo "🔬 Benchmarking Simplicity Impact v$(PIVOTPHP_VERSION)..."
	php benchmarks/simplicity-impact-analysis.php $(BENCHMARK_ITERATIONS)

benchmark-legacy: ## Benchmark Legacy vs Simplified comparison
	@echo "🔄 Benchmarking Legacy Compatibility v$(PIVOTPHP_VERSION)..."
	php benchmarks/v114-vs-v120-comparison.php $(BENCHMARK_ITERATIONS)

# === TESTES POR PHASE ===

phase1-test: ## Executa testes Phase 1 (Core v1.2.0)
	@echo "🔵 Phase 1: Core Framework v$(PIVOTPHP_VERSION) Tests..."
	php phase1/benchmarks/run-simple-v120.php
	php phase1/benchmarks/run-v120.php
	php phase1/benchmarks/run-simplicity-test.php

phase2-test: ## Executa testes Phase 2 (Extensions v1.2.0)
	@echo "🟡 Phase 2: Extensions v$(PIVOTPHP_VERSION) Tests..."
	php phase2/benchmarks/run-phase2-v120.php
	php phase2/benchmarks/run-phase2-v120-test.php
	php phase2/benchmarks/run-legacy-comparison.php

phase3-test: ## Executa testes Phase 3 (Ecosystem v1.2.0)
	@echo "🟢 Phase 3: Ecosystem v$(PIVOTPHP_VERSION) Tests..."
	php phase3/benchmarks/run-phase3-v120.php
	php phase3/benchmarks/run-phase3-reimagined.php
	cd phase3/ecosystem-validation && php ecosystem-v120-benchmark.php

openapi-test: ## Executa testes específicos OpenAPI v1.2.0 (NEW!)
	@echo "📚 OpenAPI v$(PIVOTPHP_VERSION) Tests (NEW FLAGSHIP FEATURE)..."
	cd phase3/ecosystem-validation && php openapi-ecosystem-test.php
	php benchmarks/openapi-generation-benchmark.php
	php benchmarks/swagger-ui-benchmark.php

# === ACESSO AOS CONTAINERS ===

shell-core: ## Shell para container PivotPHP Core v1.2.0
	docker-compose -f $(COMPOSE_FILE) exec pivotphp-core-v120 /bin/bash

shell-orm: ## Shell para container PivotPHP ORM v1.2.0
	docker-compose -f $(COMPOSE_FILE) exec pivotphp-orm-v120 /bin/bash

shell-reactphp: ## Shell para container PivotPHP ReactPHP v1.2.0
	docker-compose -f $(COMPOSE_FILE) exec pivotphp-reactphp-v120 /bin/bash

# === RECURSOS OPENAPI (NOVO!) ===

swagger-ui: ## Abre Swagger UI interfaces v1.2.0 (NEW!)
	@echo "📚 Abrindo Swagger UI v$(PIVOTPHP_VERSION) (NEW FEATURE)..."
	@echo "Core Swagger UI: http://localhost:8080/swagger"
	@echo "ORM Swagger UI: http://localhost:8081/swagger"
	@echo "ReactPHP Swagger UI: http://localhost:8082/swagger"
	@command -v xdg-open >/dev/null 2>&1 && xdg-open http://localhost:8080/swagger || true
	@command -v open >/dev/null 2>&1 && open http://localhost:8080/swagger || true

openapi-specs: ## Baixa especificações OpenAPI v1.2.0 (NEW!)
	@echo "📥 Baixando especificações OpenAPI v$(PIVOTPHP_VERSION)..."
	curl -s http://localhost:8080/openapi.json > results/openapi-core-v120.json
	curl -s http://localhost:8081/openapi.json > results/openapi-orm-v120.json
	curl -s http://localhost:8082/openapi.json > results/openapi-reactphp-v120.json
	@echo "✅ Especificações OpenAPI salvas em results/"

# === MONITORAMENTO ===

logs: ## Visualiza logs de todos os containers v1.2.0
	docker-compose -f $(COMPOSE_FILE) logs -f

logs-core: ## Logs apenas do container Core v1.2.0
	docker-compose -f $(COMPOSE_FILE) logs -f pivotphp-core-v120

logs-orm: ## Logs apenas do container ORM v1.2.0
	docker-compose -f $(COMPOSE_FILE) logs -f pivotphp-orm-v120

logs-reactphp: ## Logs apenas do container ReactPHP v1.2.0
	docker-compose -f $(COMPOSE_FILE) logs -f pivotphp-reactphp-v120

# === RELATÓRIOS ===

report: ## Gera relatórios v1.2.0 (incluindo OpenAPI)
	@echo "📊 Gerando relatórios PivotPHP v$(PIVOTPHP_VERSION)..."
	php scripts/generate-report-v120.php
	php scripts/generate-simplicity-report.php
	php scripts/generate-openapi-report.php
	@echo "✅ Relatórios v1.2.0 gerados em results/reports/"

# === COMPARAÇÕES DE VERSÃO ===

compare-versions: ## Compara performance v1.1.4 vs v1.2.0
	@echo "🔬 Comparando PivotPHP v1.1.4 vs v$(PIVOTPHP_VERSION)..."
	php benchmarks/v114-vs-v120-comparison.php
	@echo "📊 Análise de impacto da simplificação..."
	php benchmarks/simplicity-impact-analysis.php

# === COMANDOS DE DESENVOLVIMENTO ===

dev-setup: ## Configuração completa para desenvolvimento v1.2.0
	@echo "🛠️ Configurando ambiente de desenvolvimento v$(PIVOTPHP_VERSION)..."
	@make build
	@make up
	@make health
	@make swagger-ui
	@echo "✅ Ambiente v1.2.0 pronto para desenvolvimento!"

install-deps: ## Instala dependências para todos os frameworks v1.2.0
	@echo "📦 Instalando dependências v$(PIVOTPHP_VERSION)..."
	cd phase1 && composer install
	cd phase2 && composer install
	cd phase3 && composer install
	@echo "✅ Dependências v1.2.0 instaladas!"

# === COMANDOS DE VALIDAÇÃO COMPLETA ===

full-validation: ## Validação completa v1.2.0 (todos os testes)
	@echo "🔍 Executando validação completa PivotPHP v$(PIVOTPHP_VERSION)..."
	@echo "Philosophy: $(PHILOSOPHY)"
	@make build
	@make up
	@sleep 30
	@make health
	@make test
	@make benchmark-all
	@make compare-versions
	@make report
	@echo "✅ Validação completa v1.2.0 concluída!"

# === INFORMAÇÕES ===

info: ## Mostra informações sobre v1.2.0
	@echo "📋 PivotPHP v$(PIVOTPHP_VERSION) Information"
	@echo "=========================================="
	@echo "Philosophy: $(PHILOSOPHY)"
	@echo "Edition: Reimagined Architecture"
	@echo "Focus: Educational, prototyping, rapid development"
	@echo ""
	@echo "🚀 NEW Features in v1.2.0:"
	@echo "   - Automatic OpenAPI 3.0.0 documentation"
	@echo "   - Interactive Swagger UI at /swagger"
	@echo "   - Simplified classes (PerformanceMode, PoolManager)"
	@echo "   - 15+ automatic aliases for zero breaking changes"
	@echo "   - Legacy implementations available in src/Legacy/"
	@echo ""
	@echo "📊 Maintained from v1.1.4:"
	@echo "   - 44,092 ops/sec framework throughput"
	@echo "   - Object Pool Reuse (100% request, 99.9% response)"
	@echo "   - Revolutionary JSON performance (10.2M+ ops/sec)"
	@echo "   - PHPStan Level 9, PSR-12 compliance"
	@echo ""
	@echo "🎯 Target Audience:"
	@echo "   - Educational projects and learning"
	@echo "   - Proof of concept development"
	@echo "   - Rapid prototyping"
	@echo "   - API-first development with automatic documentation"