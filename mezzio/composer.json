{
    "name": "bench/mezzio-app",
    "description": "Voting API implemented with Mezzio (benchmark)",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-json": "*",
        "mezzio/mezzio": "^3.18",
        "mezzio/mezzio-fastroute": "^3.10",
        "laminas/laminas-diactoros": "^3.3",
        "predis/predis": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Bench\\": "app/src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
