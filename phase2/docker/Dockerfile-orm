# Dockerfile para PivotPHP + Cycle ORM - Fase 2
FROM php:8.2-cli

# Instalar extensões PHP necessárias para ORM
RUN apt-get update && apt-get install -y \
    git \
    unzip \
    libzip-dev \
    libpq-dev \
    default-mysql-client \
    && docker-php-ext-install \
    pdo \
    pdo_mysql \
    pdo_pgsql \
    zip \
    && docker-php-ext-enable opcache

# Configurar OPcache para performance
RUN echo "opcache.enable=1" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.enable_cli=1" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.memory_consumption=256" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.max_accelerated_files=20000" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.validate_timestamps=0" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.jit=1235" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.jit_buffer_size=64M" >> /usr/local/etc/php/conf.d/opcache.ini

# Instalar Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Definir diretório de trabalho
WORKDIR /var/www/html

# Copiar composer.json específico para ORM
COPY docker/composer-orm.json composer.json

# Instalar dependências
RUN composer install --no-dev --optimize-autoloader --no-interaction

# Configurar usuário
RUN groupadd -g 1000 benchmark \
    && useradd -u 1000 -g benchmark -m benchmark \
    && chown -R benchmark:benchmark /var/www/html

USER benchmark

# Expor porta
EXPOSE 8080

# Comando padrão (será sobrescrito no docker-compose)
CMD ["php", "-S", "0.0.0.0:8080", "-t", "src/orm/public"]