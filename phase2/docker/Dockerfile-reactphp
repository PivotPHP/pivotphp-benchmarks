# Dockerfile para PivotPHP + ReactPHP - Fase 2
FROM php:8.2-cli

# Instalar extensões PHP necessárias para ReactPHP
RUN apt-get update && apt-get install -y \
    git \
    unzip \
    libzip-dev \
    libevent-dev \
    libssl-dev \
    && docker-php-ext-install \
    pdo \
    pdo_mysql \
    zip \
    sockets \
    pcntl \
    && docker-php-ext-enable opcache

# Instalar ext-uv para melhor performance (opcional)
RUN pecl install uv && docker-php-ext-enable uv || true

# Configurar OPcache para performance
RUN echo "opcache.enable=1" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.enable_cli=1" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.memory_consumption=256" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.max_accelerated_files=20000" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.validate_timestamps=0" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.jit=1235" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.jit_buffer_size=64M" >> /usr/local/etc/php/conf.d/opcache.ini

# Configurações específicas para ReactPHP
RUN echo "memory_limit=512M" >> /usr/local/etc/php/conf.d/reactphp.ini \
    && echo "max_execution_time=0" >> /usr/local/etc/php/conf.d/reactphp.ini \
    && echo "default_socket_timeout=60" >> /usr/local/etc/php/conf.d/reactphp.ini

# Instalar Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Definir diretório de trabalho
WORKDIR /var/www/html

# Copiar composer.json específico para ReactPHP
COPY docker/composer-reactphp.json composer.json

# Instalar dependências
RUN composer install --no-dev --optimize-autoloader --no-interaction

# Configurar usuário
RUN groupadd -g 1000 benchmark \
    && useradd -u 1000 -g benchmark -m benchmark \
    && chown -R benchmark:benchmark /var/www/html

USER benchmark

# Expor portas
EXPOSE 8080 9090

# Comando padrão (será sobrescrito no docker-compose)
CMD ["php", "src/reactphp/server.php"]