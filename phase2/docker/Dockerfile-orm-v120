header('X-Philosophy: Simplicidade sobre Otimização Prematura');
header('X-Extension: Cycle ORM Simplified');

\$uri = \$_SERVER['REQUEST_URI'] ?? '/';
\$method = \$_SERVER['REQUEST_METHOD'] ?? 'GET';

switch (\$uri) {
    case '/health':
        http_response_code(200);
        header('Content-Type: application/json');
        echo json_encode([
            'status' => 'ok',
            'version' => '1.2.0',
            'extension' => 'cycle-orm-simplified',
            'philosophy' => 'Simplicidade sobre Otimização Prematura',
            'phase' => 2,
            'orm_features' => ['simplified-models', 'basic-queries', 'openapi-ready']
        ]);
        break;
        
    case '/api/users':
        header('Content-Type: application/json');
        echo json_encode([
            'users' => [
                ['id' => 1, 'name' => 'ORM User 1', 'email' => 'user1@pivotphp.com'],
                ['id' => 2, 'name' => 'ORM User 2', 'email' => 'user2@pivotphp.com']
            ],
            'orm' => 'Cycle ORM Simplified',
            'philosophy' => 'Simplicidade sobre Otimização Prematura',
            'database' => 'MySQL 8.0'
        ]);
        break;
        
    case '/api/orm-test':
        header('Content-Type: application/json');
        echo json_encode([
            'orm_performance' => 'simplified-but-efficient',
            'query_builder' => 'available',
            'migrations' => 'simplified',
            'models' => 'basic-hydration',
            'philosophy' => 'Simplicity over Premature Optimization'
        ]);
        break;
        
    case '/openapi.json':
        header('Content-Type: application/json');
        echo json_encode([
            'openapi' => '3.0.0',
            'info' => [
                'title' => 'PivotPHP v1.2.0 + Cycle ORM API',
                'version' => '1.2.0',
                'description' => 'Auto-generated OpenAPI for simplified ORM architecture'
            ],
            'paths' => [
                '/api/users' => [
                    'get' => [
                        'summary' => 'Get users via ORM',
                        'description' => 'Uses Cycle ORM simplified architecture',
                        'responses' => ['200' => ['description' => 'Users list']]
                    ]
                ]
            ]
        ]);
        break;
        
    case '/swagger':
        header('Content-Type: text/html');
        echo '<!DOCTYPE html><html><head><title>PivotPHP v1.2.0 + ORM API</title><link rel="stylesheet" href="https://unpkg.com/swagger-ui-dist@3.25.0/swagger-ui.css" /></head><body><div id="swagger-ui"></div><script src="https://unpkg.com/swagger-ui-dist@3.25.0/swagger-ui-bundle.js"></script><script>const ui = SwaggerUIBundle({ url: "/openapi.json", dom_id: "#swagger-ui", presets: [SwaggerUIBundle.presets.apis], layout: "StandaloneLayout" });</script></body></html>';
