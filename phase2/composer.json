{
    "name": "pivotphp/benchmark-phase2-orm",
    "description": "PivotPHP + Cycle ORM Benchmark Suite - Phase 2",
    "type": "project",
    "require": {
        "php": "^8.1",
        "pivotphp/core": "^1.1.4",
        "pivotphp/cycle-orm": "^1.0",
        "cycle/orm": "^2.0",
        "cycle/database": "^2.0",
        "cycle/migrations": "^4.0",
        "cycle/annotated": "^4.3",
        "guzzlehttp/guzzle": "^7.0",
        "symfony/console": "^6.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.8",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "PivotPHP\\Benchmark\\Phase2\\": "src/",
            "PivotPHP\\Benchmark\\Phase2\\ORM\\": "src/orm/",
            "PivotPHP\\Benchmark\\Phase2\\HighPerformance\\": "src/high-performance/",
            "PivotPHP\\Benchmark\\Shared\\": "../phase1/src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "cycle/proxy-factory": true
        }
    },
    "scripts": {
        "benchmark": "php benchmarks/orm-benchmarks.php",
        "setup-db": "php benchmarks/setup-database.php",
        "migrate": "php benchmarks/migrate.php",
        "seed": "php benchmarks/seed-database.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}