{
    "name": "pivotphp/benchmark-phase1",
    "description": "Benchmark científico isolado do PivotPHP Core - Fase 1",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "pivotphp/core": "^1.1.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "PivotPHP\\Benchmark\\Phase1\\": "src/",
            "PivotPHP\\Benchmark\\Phase1\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "benchmark": "php benchmarks/run.php",
        "test": "phpunit tests/",
        "validate": "php benchmarks/validate.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}