# Dockerfile otimizado para PivotPHP Core v1.1.4 - Phase 1 Benchmarks
# Ambiente isolado para testes de performance

FROM php:8.2-apache

LABEL maintainer="PivotPHP Benchmarks"
LABEL version="1.1.4"
LABEL phase="1"
LABEL description="PivotPHP Core v1.1.4 Enhanced Edition Benchmark Container"

# Configurar timezone
ENV TZ=UTC
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Instalar dependências do sistema
RUN apt-get update && apt-get install -y \
    git \
    curl \
    zip \
    unzip \
    libzip-dev \
    libonig-dev \
    && docker-php-ext-install zip mbstring \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Configurar e otimizar PHP para benchmarks
RUN docker-php-ext-install opcache

# Criar configuração PHP otimizada
COPY <<EOF /usr/local/etc/php/conf.d/benchmark.ini
; Configurações otimizadas para benchmark v1.1.4
memory_limit = 256M
max_execution_time = 30
max_input_time = 30

; OPcache otimizado
opcache.enable = 1
opcache.enable_cli = 1
opcache.memory_consumption = 128
opcache.interned_strings_buffer = 8
opcache.max_accelerated_files = 4000
opcache.revalidate_freq = 0
opcache.fast_shutdown = 1
opcache.save_comments = 0
opcache.enable_file_override = 1

; JIT Configuration (PHP 8.2+)
opcache.jit_buffer_size = 64M
opcache.jit = 1235

; Configurações de performance
realpath_cache_size = 4096K
realpath_cache_ttl = 600

; Desabilitar logs desnecessários para benchmark
log_errors = Off
display_errors = Off
error_reporting = E_ERROR

; Configurações de timezone
date.timezone = UTC
EOF

# Configurar Apache para performance
RUN a2enmod rewrite headers deflate expires

# Configuração Apache otimizada
COPY <<EOF /etc/apache2/sites-available/000-default.conf
<VirtualHost *:80>
    DocumentRoot /var/www/html/public
    ServerName pivotphp-benchmark-v114
    
    # Configurações de performance
    KeepAlive On
    MaxKeepAliveRequests 100
    KeepAliveTimeout 5
    
    # Headers para benchmark
    Header always set X-Framework "PivotPHP-v1.1.4"
    Header always set X-Benchmark-Phase "1"
    Header always set X-Container-Optimized "true"
    
    <Directory /var/www/html/public>
        Options -Indexes
        AllowOverride All
        Require all granted
        
        # Configurar mod_rewrite para PivotPHP
        RewriteEngine On
        RewriteCond %{REQUEST_FILENAME} !-f
        RewriteCond %{REQUEST_FILENAME} !-d
        RewriteRule ^(.*)$ index.php [QSA,L]
        
        # Headers de performance
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </Directory>
    
    # Logs mínimos para performance
    ErrorLog /var/log/apache2/error.log
    CustomLog /var/log/apache2/access.log combined
    LogLevel error
</VirtualHost>
EOF

# Instalar Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Configurar diretório de trabalho
WORKDIR /var/www/html

# Copiar arquivos do projeto
COPY composer.json composer.lock ./
COPY src/ ./src/
COPY config/ ./config/

# Instalar dependências do Composer
RUN composer install --no-dev --optimize-autoloader --no-interaction

# Copiar aplicação otimizada para v1.1.4
COPY public/index-v114.php ./public/index.php
COPY public/ ./public/

# Criar diretório de resultados
RUN mkdir -p results && chown -R www-data:www-data results

# Configurar permissões
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 /var/www/html

# Script de health check
COPY <<EOF /usr/local/bin/healthcheck.sh
#!/bin/bash
curl -f http://localhost/health || exit 1
EOF

RUN chmod +x /usr/local/bin/healthcheck.sh

# Configurar health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD /usr/local/bin/healthcheck.sh

# Otimizar configurações do container
ENV APACHE_RUN_USER=www-data
ENV APACHE_RUN_GROUP=www-data
ENV APACHE_LOG_DIR=/var/log/apache2
ENV APACHE_LOCK_DIR=/var/lock/apache2
ENV APACHE_PID_FILE=/var/run/apache2.pid

# Comando de inicialização
CMD ["apache2-foreground"]

# Expor porta
EXPOSE 80

# Labels adicionais para versionamento
LABEL pivotphp.version="1.1.4"
LABEL pivotphp.edition="Enhanced"
LABEL benchmark.phase="1"
LABEL benchmark.optimized="true"