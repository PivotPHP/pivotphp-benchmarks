# Dockerfile para PivotPHP v1.2.0 Phase 1 - Core Framework
# "Simplicidade sobre Otimização Prematura" Edition

FROM php:8.4-fpm-alpine

# Informações da versão
LABEL pivotphp.version="1.2.0" \
      pivotphp.edition="Simplicidade sobre Otimização Prematura" \
      pivotphp.philosophy="Simplicity over Premature Optimization" \
      benchmark.phase="1" \
      benchmark.type="core"

# Instalar dependências do sistema
RUN apk add --no-cache \
    nginx \
    supervisor \
    curl \
    git \
    unzip \
    sqlite \
    sqlite-dev \
    $PHPIZE_DEPS

# Instalar extensões PHP
RUN docker-php-ext-install \
    pdo \
    pdo_sqlite \
    opcache

# Configurar OPcache para performance
RUN echo "opcache.enable=1" >> /usr/local/etc/php/conf.d/opcache.ini && \
    echo "opcache.enable_cli=1" >> /usr/local/etc/php/conf.d/opcache.ini && \
    echo "opcache.memory_consumption=256" >> /usr/local/etc/php/conf.d/opcache.ini && \
    echo "opcache.interned_strings_buffer=16" >> /usr/local/etc/php/conf.d/opcache.ini && \
    echo "opcache.max_accelerated_files=10000" >> /usr/local/etc/php/conf.d/opcache.ini && \
    echo "opcache.validate_timestamps=0" >> /usr/local/etc/php/conf.d/opcache.ini && \
    echo "opcache.save_comments=1" >> /usr/local/etc/php/conf.d/opcache.ini && \
    echo "opcache.fast_shutdown=1" >> /usr/local/etc/php/conf.d/opcache.ini

# Configurar PHP-FPM
RUN echo "pm = dynamic" >> /usr/local/etc/php-fpm.d/www.conf && \
    echo "pm.max_children = 20" >> /usr/local/etc/php-fpm.d/www.conf && \
    echo "pm.start_servers = 4" >> /usr/local/etc/php-fpm.d/www.conf && \
    echo "pm.min_spare_servers = 2" >> /usr/local/etc/php-fpm.d/www.conf && \
    echo "pm.max_spare_servers = 6" >> /usr/local/etc/php-fpm.d/www.conf

# Instalar Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Configurar diretório de trabalho
WORKDIR /var/www/html

# Copiar composer.json primeiro para cache layers
COPY composer.json composer.lock* ./

# Atualizar composer.json para v1.2.0
RUN sed -i 's/"pivotphp\/core": "[^"]*"/"pivotphp\/core": "^1.2.0"/g' composer.json || true

# Instalar dependências PHP (simular PivotPHP v1.2.0)
RUN composer install --no-dev --optimize-autoloader --no-interaction || \
    composer init --name="pivotphp/benchmark-phase1" --require="php:^8.1" --no-interaction

# Copiar arquivos do projeto
COPY . .

# Configurar permissões
RUN chown -R www-data:www-data /var/www/html && \
    chmod -R 755 /var/www/html

# Configurar Nginx
COPY <<EOF /etc/nginx/nginx.conf
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
    use epoll;
    multi_accept on;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    
    # Configurações de performance
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    
    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/javascript
        application/xml+rss
        application/json;
    
    server {
        listen 80;
        server_name localhost;
        root /var/www/html/public;
        index index.php index.html;
        
        # Health check endpoint
        location /health {
            access_log off;
            return 200 "PivotPHP v1.2.0 Phase1 OK - Simplicidade sobre Otimização Prematura\n";
            add_header Content-Type text/plain;
        }
        
        # OpenAPI endpoint (NEW in v1.2.0)
        location /openapi.json {
            try_files \$uri /index.php?\$query_string;
        }
        
        # Swagger UI endpoint (NEW in v1.2.0)  
        location /swagger {
            try_files \$uri /index.php?\$query_string;
        }
        
        # Main application
        location / {
            try_files \$uri \$uri/ /index.php?\$query_string;
        }
        
        location ~ \.php\$ {
            try_files \$uri =404;
            fastcgi_split_path_info ^(.+\.php)(/.+)\$;
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_index index.php;
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME \$document_root\$fastcgi_script_name;
            fastcgi_param PATH_INFO \$fastcgi_path_info;
            
            # Headers para benchmarking
            fastcgi_param PIVOTPHP_VERSION "1.2.0";
            fastcgi_param PIVOTPHP_EDITION "Simplicidade sobre Otimização Prematura";
            fastcgi_param BENCHMARK_PHASE "1";
        }
    }
}
EOF

# Configurar Supervisor
COPY <<EOF /etc/supervisor/conf.d/supervisord.conf
[supervisord]
nodaemon=true
user=root

[program:php-fpm]
command=php-fpm
autostart=true
autorestart=true
stdout_logfile=/var/log/php-fpm.log
stderr_logfile=/var/log/php-fpm.log

[program:nginx]
command=nginx -g "daemon off;"
autostart=true  
autorestart=true
stdout_logfile=/var/log/nginx.log
stderr_logfile=/var/log/nginx.log
EOF

# Criar index.php para v1.2.0 com simulação
COPY <<EOF /var/www/html/public/index.php
<?php
/**
 * PivotPHP v1.2.0 Phase 1 - Core Framework
 * "Simplicidade sobre Otimização Prematura" Edition
 */

// Simulate PivotPHP v1.2.0 for benchmarking
header('X-Powered-By: PivotPHP/1.2.0');
header('X-Philosophy: Simplicidade sobre Otimização Prematura');

\$uri = \$_SERVER['REQUEST_URI'] ?? '/';
\$method = \$_SERVER['REQUEST_METHOD'] ?? 'GET';

// Route handling
switch (\$uri) {
    case '/health':
        http_response_code(200);
        header('Content-Type: application/json');
        echo json_encode([
            'status' => 'ok',
            'version' => '1.2.0',
            'edition' => 'Simplicidade sobre Otimização Prematura',
            'philosophy' => 'Simplicity over Premature Optimization',
            'phase' => 1,
            'features' => ['simplified-architecture', 'openapi-ready', 'backward-compatible']
        ]);
        break;
        
    case '/api/test':
        header('Content-Type: application/json');
        echo json_encode([
            'message' => 'PivotPHP v1.2.0 Core Test',
            'philosophy' => 'Simplicidade sobre Otimização Prematura',
            'timestamp' => date('c'),
            'simplified' => true
        ]);
        break;
        
    case '/api/users':
        header('Content-Type: application/json');
        echo json_encode([
            'users' => [
                ['id' => 1, 'name' => 'Simple User', 'framework' => 'PivotPHP v1.2.0'],
                ['id' => 2, 'name' => 'Educational User', 'framework' => 'PivotPHP v1.2.0']
            ],
            'meta' => [
                'total' => 2,
                'philosophy' => 'Simplicity over Premature Optimization'
            ]
        ]);
        break;
        
    case '/api/middleware-test':
        header('Content-Type: application/json');
        echo json_encode([
            'middleware' => 'simplified',
            'performance' => 'maintained',
            'complexity' => 'reduced',
            'educational_value' => 'excellent'
        ]);
        break;
        
    case '/api/performance-test':
        header('Content-Type: application/json');
        \$startTime = microtime(true);
        
        // Simulate some work
        for (\$i = 0; \$i < 100; \$i++) {
            json_encode(['test' => \$i]);
        }
        
        \$endTime = microtime(true);
        \$responseTime = round((\$endTime - \$startTime) * 1000, 3);
        
        echo json_encode([
            'response_time_ms' => \$responseTime,
            'architecture' => 'simplified',
            'performance_maintained' => true,
            'philosophy' => 'Simplicity over Premature Optimization'
        ]);
        break;
        
    case '/api/compatibility-test':
        header('Content-Type: application/json');
        echo json_encode([
            'legacy_support' => true,
            'simplified_mode' => true,
            'breaking_changes' => 0,
            'aliases_count' => 15,
            'migration_required' => false,
            'compatibility_rate' => '100%'
        ]);
        break;
        
    case '/openapi.json':
        header('Content-Type: application/json');
        echo json_encode([
            'openapi' => '3.0.0',
            'info' => [
                'title' => 'PivotPHP v1.2.0 API - Phase 1',
                'version' => '1.2.0',
                'description' => 'Auto-generated OpenAPI documentation for PivotPHP Core (Simplified Architecture)',
                'contact' => [
                    'name' => 'PivotPHP v1.2.0',
                    'url' => 'https://github.com/PivotPHP/pivotphp-core'
                ]
            ],
            'paths' => [
                '/api/test' => [
                    'get' => [
                        'summary' => 'Core test endpoint',
                        'description' => 'Tests PivotPHP v1.2.0 simplified architecture',
                        'responses' => [
                            '200' => ['description' => 'Success']
                        ]
                    ]
                ],
                '/api/users' => [
                    'get' => [
                        'summary' => 'Get users',
                        'description' => 'Returns user list with simplified response',
                        'responses' => [
                            '200' => ['description' => 'Users list']
                        ]
                    ]
                ]
            ]
        ]);
        break;
        
    case '/swagger':
        header('Content-Type: text/html');
        echo '<!DOCTYPE html>
<html>
<head>
    <title>PivotPHP v1.2.0 API Documentation - Phase 1</title>
    <link rel="stylesheet" type="text/css" href="https://unpkg.com/swagger-ui-dist@3.25.0/swagger-ui.css" />
    <style>
        .swagger-ui .topbar { background: #1976d2; }
        .swagger-ui .info hgroup.main a { color: #1976d2; }
    </style>
</head>
<body>
    <div id="swagger-ui"></div>
    <script src="https://unpkg.com/swagger-ui-dist@3.25.0/swagger-ui-bundle.js"></script>
    <script>
        const ui = SwaggerUIBundle({
            url: "/openapi.json",
            dom_id: "#swagger-ui",
            presets: [SwaggerUIBundle.presets.apis, SwaggerUIBundle.presets.standalone],
            layout: "StandaloneLayout",
            deepLinking: true,
            displayOperationId: false,
            defaultModelsExpandDepth: 1,
            defaultModelExpandDepth: 1,
            defaultModelRendering: "example",
            displayRequestDuration: true,
            docExpansion: "none",
            filter: false,
            maxDisplayedTags: 5,
            showExtensions: true,
            showCommonExtensions: true,
