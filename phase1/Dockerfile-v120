</body>
</html>';
        break;
        
    default:
        header('Content-Type: application/json');
        echo json_encode([
            'framework' => 'PivotPHP',
            'version' => '1.2.0',
            'edition' => 'Simplicidade sobre Otimização Prematura',
            'philosophy' => 'Simplicity over Premature Optimization',
            'phase' => 1,
            'message' => 'Welcome to PivotPHP v1.2.0 Core Framework',
            'features' => [
                'simplified_architecture' => true,
                'openapi_documentation' => true,
                'swagger_ui' => true,
                'backward_compatible' => true,
                'educational_focus' => true
            ],
            'endpoints' => [
                '/health' => 'Health check',
                '/api/test' => 'Core test endpoint', 
                '/api/users' => 'Users list',
                '/openapi.json' => 'OpenAPI 3.0.0 specification',
                '/swagger' => 'Interactive Swagger UI'
            ]
        ]);
        break;
}
EOF

# Expor porta
EXPOSE 80

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

# Comando padrão
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]