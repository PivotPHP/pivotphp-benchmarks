{
    "name": "bench/pivotphp-app",
    "description": "Voting API implemented with PivotPHP (benchmark)",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "pivotphp/core": "^5.1",
        "pivotphp/http": "^1.0",
        "predis/predis": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Bench\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
