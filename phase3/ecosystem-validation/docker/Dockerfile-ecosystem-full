# PivotPHP Full Ecosystem Docker Image
# Contains Core + ReactPHP + Cycle ORM for comprehensive testing
# Optimized for production-ready performance validation

FROM php:8.2-fpm-alpine

# Install system dependencies
RUN apk add --no-cache \
    curl \
    git \
    unzip \
    libzip-dev \
    libpng-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    oniguruma-dev \
    postgresql-dev \
    mysql-client \
    supervisor \
    nginx \
    && rm -rf /var/cache/apk/*

# Install PHP extensions
RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        pdo \
        pdo_mysql \
        pdo_pgsql \
        mysqli \
        zip \
        gd \
        mbstring \
        opcache \
        sockets \
        pcntl \
        posix \
        bcmath

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Set working directory
WORKDIR /app

# Copy composer files
COPY composer.json composer.lock ./

# Install PHP dependencies
RUN composer install --no-dev --optimize-autoloader --no-scripts

# Copy application code
COPY . .

# Install PivotPHP ecosystem packages
RUN composer require pivotphp/core:^1.1.4 \
    && composer require pivotphp/reactphp:^0.1.0 \
    && composer require pivotphp/cycle-orm:^1.0.1

# Configure PHP for optimal performance
RUN echo "opcache.enable=1" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.jit_buffer_size=100M" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.jit=1255" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.memory_consumption=256" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.max_accelerated_files=20000" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.validate_timestamps=0" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.save_comments=1" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.enable_file_override=1" >> /usr/local/etc/php/conf.d/opcache.ini

# Configure PHP settings for ecosystem
RUN echo "memory_limit=512M" >> /usr/local/etc/php/conf.d/ecosystem.ini \
    && echo "max_execution_time=0" >> /usr/local/etc/php/conf.d/ecosystem.ini \
    && echo "max_input_time=0" >> /usr/local/etc/php/conf.d/ecosystem.ini \
    && echo "post_max_size=64M" >> /usr/local/etc/php/conf.d/ecosystem.ini \
    && echo "upload_max_filesize=64M" >> /usr/local/etc/php/conf.d/ecosystem.ini \
    && echo "default_charset=UTF-8" >> /usr/local/etc/php/conf.d/ecosystem.ini

# Create ecosystem application
RUN mkdir -p /app/public /app/src /app/config /app/database /app/logs

# Copy ecosystem application files
COPY ecosystem-app/ /app/

# Create ecosystem bootstrap file
RUN cat > /app/ecosystem-bootstrap.php << 'EOF'
<?php

declare(strict_types=1);

require_once __DIR__ . '/vendor/autoload.php';

use PivotPHP\Core\Core\Application;
use PivotPHP\ReactPHP\Providers\ReactPHPServiceProvider;
use PivotPHP\CycleORM\CycleServiceProvider;

// Create application
$app = new Application();

// Register all ecosystem components
$app->register(new ReactPHPServiceProvider($app));
$app->register(new CycleServiceProvider($app));

// Define ecosystem routes
$app->get('/health', function($req, $res) {
    return $res->json([
        'status' => 'healthy',
        'ecosystem' => 'full',
        'components' => [
            'core' => 'v1.1.4',
            'reactphp' => 'v0.1.0',
            'cycle_orm' => 'v1.0.1'
        ],
        'timestamp' => time(),
        'memory_usage' => memory_get_usage(true),
        'peak_memory' => memory_get_peak_usage(true)
    ]);
});

$app->get('/api/performance', function($req, $res) {
    $startTime = microtime(true);
    
    // Simulate complex processing
    $data = [
        'request_id' => uniqid(),
        'processing_time' => microtime(true) - $startTime,
        'ecosystem_components' => [
            'core_framework' => true,
            'reactphp_runtime' => true,
            'cycle_orm' => true
        ],
        'performance_metrics' => [
            'memory_usage' => memory_get_usage(true),
            'peak_memory' => memory_get_peak_usage(true),
            'response_time' => microtime(true) - $startTime
        ]
    ];
    
    return $res->json($data);
});

$app->get('/api/database', function($req, $res) {
    // Simulate database operations
    $users = [
        ['id' => 1, 'name' => 'User 1', 'email' => 'user1@ecosystem.test'],
        ['id' => 2, 'name' => 'User 2', 'email' => 'user2@ecosystem.test'],
        ['id' => 3, 'name' => 'User 3', 'email' => 'user3@ecosystem.test']
    ];
    
    return $res->json([
        'users' => $users,
        'total' => count($users),
        'query_time' => '0.001ms',
        'cache_hit' => true
    ]);
});

$app->post('/api/realtime', function($req, $res) {
    $data = $req->body();
    
    // Simulate real-time processing
    $result = [
        'received_at' => microtime(true),
        'processed_at' => microtime(true),
        'input_data' => $data,
        'realtime_id' => uniqid('rt_'),
        'websocket_ready' => true,
        'event_loop_active' => true
    ];
    
    return $res->json($result);
});

// Complex workflow endpoint
$app->post('/api/workflow', function($req, $res) {
    $input = $req->body();
    $startTime = microtime(true);
    
    // Simulate complex business logic
    $steps = [
        'input_validation' => true,
        'database_query' => true,
        'business_logic' => true,
        'cache_update' => true,
        'event_dispatch' => true,
        'response_formatting' => true
    ];
    
    $result = [
        'workflow_id' => uniqid('wf_'),
        'input' => $input,
        'steps' => $steps,
        'execution_time' => microtime(true) - $startTime,
        'success' => true,
        'ecosystem_components_used' => [
            'core_routing' => true,
            'reactphp_async' => true,
            'cycle_orm_database' => true
        ]
    ];
    
    return $res->json($result);
});

return $app;
EOF

# Create nginx configuration
RUN cat > /etc/nginx/nginx.conf << 'EOF'
user nginx;
worker_processes auto;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
    use epoll;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    
    server {
        listen 8080;
        server_name localhost;
        root /app/public;
        index index.php;
        
        location / {
            try_files $uri $uri/ /index.php?$query_string;
        }
        
        location ~ \.php$ {
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_index index.php;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            include fastcgi_params;
        }
        
        location /health {
            access_log off;
            return 200 "healthy\n";
            add_header Content-Type text/plain;
        }
    }
}
EOF

# Create public/index.php
RUN cat > /app/public/index.php << 'EOF'
<?php
$app = require __DIR__ . '/../ecosystem-bootstrap.php';
$app->run();
EOF

# Create supervisor configuration
RUN cat > /etc/supervisor/conf.d/ecosystem.conf << 'EOF'
[supervisord]
nodaemon=true
user=root

[program:php-fpm]
command=php-fpm --nodaemonize
autostart=true
autorestart=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0

[program:nginx]
command=nginx -g "daemon off;"
autostart=true
autorestart=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0

[program:reactphp-server]
command=php /app/reactphp-server.php
autostart=true
autorestart=true
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
EOF

# Create ReactPHP server
RUN cat > /app/reactphp-server.php << 'EOF'
<?php

require_once __DIR__ . '/vendor/autoload.php';

use React\EventLoop\Loop;
use React\Socket\SocketServer;
use React\Http\HttpServer;
use React\Http\Message\Response;
use Psr\Http\Message\ServerRequestInterface;

$loop = Loop::get();

$server = new HttpServer(function (ServerRequestInterface $request) {
    $path = $request->getUri()->getPath();
    
    switch ($path) {
        case '/reactphp/health':
            return new Response(200, ['Content-Type' => 'application/json'], json_encode([
                'status' => 'healthy',
                'server' => 'ReactPHP',
                'memory_usage' => memory_get_usage(true),
                'timestamp' => microtime(true)
            ]));
            
        case '/reactphp/performance':
            return new Response(200, ['Content-Type' => 'application/json'], json_encode([
                'server' => 'ReactPHP',
                'continuous_runtime' => true,
                'event_loop_active' => true,
                'memory_usage' => memory_get_usage(true),
                'uptime' => time() - $_SERVER['REQUEST_TIME_FLOAT']
            ]));
            
        default:
            return new Response(404, ['Content-Type' => 'application/json'], json_encode([
                'error' => 'Not Found',
                'path' => $path
            ]));
    }
});

$socket = new SocketServer('0.0.0.0:8081', [], $loop);
$server->listen($socket);

echo "ReactPHP server listening on 0.0.0.0:8081\n";
$loop->run();
EOF

# Set permissions
RUN chown -R nginx:nginx /app \
    && chmod -R 755 /app \
    && chmod +x /app/reactphp-server.php

# Health check script
RUN cat > /app/health-check.php << 'EOF'
<?php
$health = [
    'status' => 'healthy',
    'timestamp' => time(),
    'services' => [
        'nginx' => true,
        'php-fpm' => true,
        'reactphp' => true
    ]
];

header('Content-Type: application/json');
echo json_encode($health);
EOF

# Expose ports
EXPOSE 8080 8081

# Start supervisor
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/ecosystem.conf"]