FROM php:8.4-fpm-alpine

# Install system dependencies
RUN apk add --no-cache \
    git \
    curl \
    libzip-dev \
    zip \
    unzip \
    nginx

# Install PHP extensions
RUN docker-php-ext-install pdo_mysql zip opcache

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Configure OPcache for performance
RUN echo "opcache.enable=1" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.enable_cli=1" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.jit=1235" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.jit_buffer_size=256M" >> /usr/local/etc/php/conf.d/opcache.ini

# Set working directory
WORKDIR /var/www/html

# Copy application files
COPY . .

# Create mock PivotPHP Core + ReactPHP application
RUN mkdir -p /var/www/html/public /var/www/html/src
RUN echo '<?php' > /var/www/html/public/index.php
RUN echo 'echo json_encode(["status" => "healthy", "config" => "core-reactphp", "timestamp" => time(), "features" => ["async", "websocket"]]);' >> /var/www/html/public/index.php

# Health check endpoint
RUN echo '<?php' > /var/www/html/public/health.php
RUN echo 'http_response_code(200);' >> /var/www/html/public/health.php
RUN echo 'echo json_encode(["status" => "healthy", "service" => "pivotphp-core-reactphp", "runtime" => "continuous"]);' >> /var/www/html/public/health.php

# Configure nginx
RUN echo 'server {' > /etc/nginx/http.d/default.conf
RUN echo '    listen 80;' >> /etc/nginx/http.d/default.conf
RUN echo '    root /var/www/html/public;' >> /etc/nginx/http.d/default.conf
RUN echo '    index index.php;' >> /etc/nginx/http.d/default.conf
RUN echo '    location / {' >> /etc/nginx/http.d/default.conf
RUN echo '        try_files $uri $uri/ /index.php?$query_string;' >> /etc/nginx/http.d/default.conf
RUN echo '    }' >> /etc/nginx/http.d/default.conf
RUN echo '    location ~ \.php$ {' >> /etc/nginx/http.d/default.conf
RUN echo '        fastcgi_pass 127.0.0.1:9000;' >> /etc/nginx/http.d/default.conf
RUN echo '        fastcgi_index index.php;' >> /etc/nginx/http.d/default.conf
RUN echo '        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;' >> /etc/nginx/http.d/default.conf
RUN echo '        include fastcgi_params;' >> /etc/nginx/http.d/default.conf
RUN echo '    }' >> /etc/nginx/http.d/default.conf
RUN echo '}' >> /etc/nginx/http.d/default.conf

# Start script
RUN echo '#!/bin/sh' > /start.sh
RUN echo 'php-fpm -D' >> /start.sh
RUN echo 'nginx -g "daemon off;"' >> /start.sh
RUN chmod +x /start.sh

EXPOSE 80

CMD ["/start.sh"]