FROM php:8.4-fpm-alpine

# Install system dependencies (same as other frameworks)
RUN apk add --no-cache \
    curl \
    git \
    unzip \
    libzip-dev \
    nginx \
    supervisor \
    && rm -rf /var/cache/apk/*

# Install PHP extensions (equivalent to other frameworks)
RUN docker-php-ext-install \
    pdo_mysql \
    zip \
    opcache

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Configure OPcache for cross-framework benchmarks (standard configuration)
RUN echo "opcache.enable=1" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.enable_cli=1" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.jit=1255" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.jit_buffer_size=256M" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.memory_consumption=256" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.max_accelerated_files=20000" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.validate_timestamps=0" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.save_comments=1" >> /usr/local/etc/php/conf.d/opcache.ini

# Configure PHP for production (standard cross-framework settings)
RUN echo "memory_limit=512M" >> /usr/local/etc/php/conf.d/production.ini \
    && echo "max_execution_time=30" >> /usr/local/etc/php/conf.d/production.ini \
    && echo "expose_php=Off" >> /usr/local/etc/php/conf.d/production.ini \
    && echo "log_errors=On" >> /usr/local/etc/php/conf.d/production.ini \
    && echo "display_errors=Off" >> /usr/local/etc/php/conf.d/production.ini

# Set working directory
WORKDIR /var/www/html

# Create application structure (equivalent to other frameworks)
RUN mkdir -p /var/www/html/public \
    && mkdir -p /var/www/html/src \
    && mkdir -p /var/www/html/config \
    && mkdir -p /var/www/html/results

# Copy Composer files first (Docker layer caching)
COPY composer.json composer.lock* ./

# Install dependencies (same pattern as other frameworks)
RUN composer install --no-dev --optimize-autoloader --no-scripts --prefer-dist

# Copy application files
COPY . .

# Create PivotPHP Full Ecosystem application (cross-framework compatible)
RUN echo '<?php' > /var/www/html/public/index.php \
    && echo 'require_once __DIR__ . "/../vendor/autoload.php";' >> /var/www/html/public/index.php \
    && echo '' >> /var/www/html/public/index.php \
    && echo '// PivotPHP Full Ecosystem - Cross-Framework Benchmark' >> /var/www/html/public/index.php \
    && echo 'use PivotPHP\\Core\\Application;' >> /var/www/html/public/index.php \
    && echo 'use PivotPHP\\Http\\Request;' >> /var/www/html/public/index.php \
    && echo 'use PivotPHP\\Http\\Response;' >> /var/www/html/public/index.php \
    && echo '' >> /var/www/html/public/index.php \
    && echo '$app = new Application();' >> /var/www/html/public/index.php \
    && echo '' >> /var/www/html/public/index.php \
    && echo '// Standard benchmark routes (same as other frameworks)' >> /var/www/html/public/index.php \
    && echo '$app->get("/", function($req, $res) {' >> /var/www/html/public/index.php \
    && echo '    return $res->json([' >> /var/www/html/public/index.php \
    && echo '        "message" => "PivotPHP Full Ecosystem v1.1.4",' >> /var/www/html/public/index.php \
    && echo '        "components" => ["core", "reactphp", "cycle-orm"],' >> /var/www/html/public/index.php \
    && echo '        "timestamp" => time()' >> /var/www/html/public/index.php \
    && echo '    ]);' >> /var/www/html/public/index.php \
    && echo '});' >> /var/www/html/public/index.php \
    && echo '' >> /var/www/html/public/index.php \
    && echo '$app->get("/api", function($req, $res) {' >> /var/www/html/public/index.php \
    && echo '    return $res->json(["status" => "ok", "framework" => "pivotphp-full-ecosystem"]);' >> /var/www/html/public/index.php \
    && echo '});' >> /var/www/html/public/index.php \
    && echo '' >> /var/www/html/public/index.php \
    && echo '$app->get("/health", function($req, $res) {' >> /var/www/html/public/index.php \
    && echo '    http_response_code(200);' >> /var/www/html/public/index.php \
    && echo '    return $res->json(["status" => "healthy", "framework" => "pivotphp-full-ecosystem"]);' >> /var/www/html/public/index.php \
    && echo '});' >> /var/www/html/public/index.php \
    && echo '' >> /var/www/html/public/index.php \
    && echo '$app->run();' >> /var/www/html/public/index.php

# Configure nginx (standard configuration for cross-framework benchmarks)
RUN echo 'server {' > /etc/nginx/http.d/default.conf \
    && echo '    listen 80;' >> /etc/nginx/http.d/default.conf \
    && echo '    server_name localhost;' >> /etc/nginx/http.d/default.conf \
    && echo '    root /var/www/html/public;' >> /etc/nginx/http.d/default.conf \
    && echo '    index index.php;' >> /etc/nginx/http.d/default.conf \
    && echo '' >> /etc/nginx/http.d/default.conf \
    && echo '    # Standard location block (same as other frameworks)' >> /etc/nginx/http.d/default.conf \
    && echo '    location / {' >> /etc/nginx/http.d/default.conf \
    && echo '        try_files $uri $uri/ /index.php?$query_string;' >> /etc/nginx/http.d/default.conf \
    && echo '    }' >> /etc/nginx/http.d/default.conf \
    && echo '' >> /etc/nginx/http.d/default.conf \
    && echo '    # PHP processing (optimized for benchmarks)' >> /etc/nginx/http.d/default.conf \
    && echo '    location ~ \.php$ {' >> /etc/nginx/http.d/default.conf \
    && echo '        fastcgi_pass 127.0.0.1:9000;' >> /etc/nginx/http.d/default.conf \
    && echo '        fastcgi_index index.php;' >> /etc/nginx/http.d/default.conf \
    && echo '        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;' >> /etc/nginx/http.d/default.conf \
    && echo '        include fastcgi_params;' >> /etc/nginx/http.d/default.conf \
    && echo '        fastcgi_buffer_size 128k;' >> /etc/nginx/http.d/default.conf \
    && echo '        fastcgi_buffers 256 16k;' >> /etc/nginx/http.d/default.conf \
    && echo '        fastcgi_busy_buffers_size 256k;' >> /etc/nginx/http.d/default.conf \
    && echo '        fastcgi_temp_file_write_size 256k;' >> /etc/nginx/http.d/default.conf \
    && echo '    }' >> /etc/nginx/http.d/default.conf \
    && echo '}' >> /etc/nginx/http.d/default.conf

# Configure supervisor (standard process management)
RUN echo '[supervisord]' > /etc/supervisor/conf.d/supervisord.conf \
    && echo 'nodaemon=true' >> /etc/supervisor/conf.d/supervisord.conf \
    && echo 'user=root' >> /etc/supervisor/conf.d/supervisord.conf \
    && echo '' >> /etc/supervisor/conf.d/supervisord.conf \
    && echo '[program:php-fpm]' >> /etc/supervisor/conf.d/supervisord.conf \
    && echo 'command=php-fpm -F' >> /etc/supervisor/conf.d/supervisord.conf \
    && echo 'autostart=true' >> /etc/supervisor/conf.d/supervisord.conf \
    && echo 'autorestart=true' >> /etc/supervisor/conf.d/supervisord.conf \
    && echo 'priority=5' >> /etc/supervisor/conf.d/supervisord.conf \
    && echo 'stdout_logfile=/dev/stdout' >> /etc/supervisor/conf.d/supervisord.conf \
    && echo 'stdout_logfile_maxbytes=0' >> /etc/supervisor/conf.d/supervisord.conf \
    && echo 'stderr_logfile=/dev/stderr' >> /etc/supervisor/conf.d/supervisord.conf \
    && echo 'stderr_logfile_maxbytes=0' >> /etc/supervisor/conf.d/supervisord.conf \
    && echo '' >> /etc/supervisor/conf.d/supervisord.conf \
    && echo '[program:nginx]' >> /etc/supervisor/conf.d/supervisord.conf \
    && echo 'command=nginx -g "daemon off;"' >> /etc/supervisor/conf.d/supervisord.conf \
    && echo 'autostart=true' >> /etc/supervisor/conf.d/supervisord.conf \
    && echo 'autorestart=true' >> /etc/supervisor/conf.d/supervisord.conf \
    && echo 'priority=10' >> /etc/supervisor/conf.d/supervisord.conf \
    && echo 'stdout_logfile=/dev/stdout' >> /etc/supervisor/conf.d/supervisord.conf \
    && echo 'stdout_logfile_maxbytes=0' >> /etc/supervisor/conf.d/supervisord.conf \
    && echo 'stderr_logfile=/dev/stderr' >> /etc/supervisor/conf.d/supervisord.conf \
    && echo 'stderr_logfile_maxbytes=0' >> /etc/supervisor/conf.d/supervisord.conf

# Set proper permissions
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 /var/www/html

EXPOSE 80

# Standard startup command (same pattern as other frameworks)
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]