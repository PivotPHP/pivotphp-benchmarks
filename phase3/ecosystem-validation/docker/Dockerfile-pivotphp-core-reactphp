FROM php:8.4-fpm-alpine

# Install system dependencies
RUN apk add --no-cache \
    curl \
    git \
    unzip \
    libzip-dev \
    nginx \
    supervisor \
    && rm -rf /var/cache/apk/*

# Install PHP extensions (including sockets for ReactPHP if available)
RUN docker-php-ext-install \
    pdo_mysql \
    zip \
    opcache

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Configure OPcache
RUN echo "opcache.enable=1" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.enable_cli=1" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.jit=1255" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.jit_buffer_size=256M" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.memory_consumption=256" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.max_accelerated_files=20000" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.validate_timestamps=0" >> /usr/local/etc/php/conf.d/opcache.ini

# Configure PHP
RUN echo "memory_limit=512M" >> /usr/local/etc/php/conf.d/production.ini \
    && echo "max_execution_time=0" >> /usr/local/etc/php/conf.d/production.ini

# Set working directory
WORKDIR /var/www/html

# Create structure
RUN mkdir -p /var/www/html/public \
    && mkdir -p /var/www/html/results

# Copy composer files
COPY composer.json composer.lock* ./

# Install dependencies (core + reactphp)
RUN composer require pivotphp/core:^1.1.4 --no-scripts --optimize-autoloader \
    && composer require pivotphp/reactphp:^0.1.0 --no-scripts --optimize-autoloader

# Create PivotPHP Core + ReactPHP application
RUN echo '<?php' > /var/www/html/public/index.php \
    && echo 'require_once __DIR__ . "/../vendor/autoload.php";' >> /var/www/html/public/index.php \
    && echo '' >> /var/www/html/public/index.php \
    && echo '// PivotPHP Core + ReactPHP - Cross-Framework Test' >> /var/www/html/public/index.php \
    && echo 'use PivotPHP\\Core\\Application;' >> /var/www/html/public/index.php \
    && echo '' >> /var/www/html/public/index.php \
    && echo '$app = new Application();' >> /var/www/html/public/index.php \
    && echo '' >> /var/www/html/public/index.php \
    && echo '// Enable ReactPHP features (simulated)' >> /var/www/html/public/index.php \
    && echo '$reactphpEnabled = true;' >> /var/www/html/public/index.php \
    && echo '' >> /var/www/html/public/index.php \
    && echo '$app->get("/", function($req, $res) use ($reactphpEnabled) {' >> /var/www/html/public/index.php \
    && echo '    return $res->json([' >> /var/www/html/public/index.php \
    && echo '        "framework" => "PivotPHP Core + ReactPHP",' >> /var/www/html/public/index.php \
    && echo '        "version" => "1.1.4",' >> /var/www/html/public/index.php \
    && echo '        "config" => "core_reactphp",' >> /var/www/html/public/index.php \
    && echo '        "components" => ["core", "reactphp"],' >> /var/www/html/public/index.php \
    && echo '        "features" => ["async", "websocket", "continuous_runtime"],' >> /var/www/html/public/index.php \
    && echo '        "reactphp_enabled" => $reactphpEnabled,' >> /var/www/html/public/index.php \
    && echo '        "timestamp" => time()' >> /var/www/html/public/index.php \
    && echo '    ]);' >> /var/www/html/public/index.php \
    && echo '});' >> /var/www/html/public/index.php \
    && echo '' >> /var/www/html/public/index.php \
    && echo '$app->get("/api", function($req, $res) {' >> /var/www/html/public/index.php \
    && echo '    return $res->json([' >> /var/www/html/public/index.php \
    && echo '        "status" => "ok",' >> /var/www/html/public/index.php \
    && echo '        "framework" => "pivotphp-core-reactphp",' >> /var/www/html/public/index.php \
    && echo '        "performance_target" => "8000-10000 req/sec",' >> /var/www/html/public/index.php \
    && echo '        "async_capable" => true' >> /var/www/html/public/index.php \
    && echo '    ]);' >> /var/www/html/public/index.php \
    && echo '});' >> /var/www/html/public/index.php \
    && echo '' >> /var/www/html/public/index.php \
    && echo '$app->get("/health", function($req, $res) {' >> /var/www/html/public/index.php \
    && echo '    return $res->json([' >> /var/www/html/public/index.php \
    && echo '        "status" => "healthy",' >> /var/www/html/public/index.php \
    && echo '        "framework" => "pivotphp-core-reactphp",' >> /var/www/html/public/index.php \
    && echo '        "config" => "core_reactphp",' >> /var/www/html/public/index.php \
    && echo '        "runtime" => "continuous"' >> /var/www/html/public/index.php \
    && echo '    ]);' >> /var/www/html/public/index.php \
    && echo '});' >> /var/www/html/public/index.php \
    && echo '' >> /var/www/html/public/index.php \
    && echo '$app->run();' >> /var/www/html/public/index.php

# Configure nginx
RUN echo 'server {' > /etc/nginx/http.d/default.conf \
    && echo '    listen 80;' >> /etc/nginx/http.d/default.conf \
    && echo '    root /var/www/html/public;' >> /etc/nginx/http.d/default.conf \
    && echo '    index index.php;' >> /etc/nginx/http.d/default.conf \
    && echo '    location / {' >> /etc/nginx/http.d/default.conf \
    && echo '        try_files $uri $uri/ /index.php?$query_string;' >> /etc/nginx/http.d/default.conf \
    && echo '    }' >> /etc/nginx/http.d/default.conf \
    && echo '    location ~ \.php$ {' >> /etc/nginx/http.d/default.conf \
    && echo '        fastcgi_pass 127.0.0.1:9000;' >> /etc/nginx/http.d/default.conf \
    && echo '        fastcgi_index index.php;' >> /etc/nginx/http.d/default.conf \
    && echo '        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;' >> /var/www/html/public/index.php \
    && echo '        include fastcgi_params;' >> /etc/nginx/http.d/default.conf \
    && echo '    }' >> /etc/nginx/http.d/default.conf \
    && echo '}' >> /etc/nginx/http.d/default.conf

# Configure supervisor
RUN echo '[supervisord]' > /etc/supervisor/conf.d/supervisord.conf \
    && echo 'nodaemon=true' >> /etc/supervisor/conf.d/supervisord.conf \
    && echo '[program:php-fpm]' >> /etc/supervisor/conf.d/supervisord.conf \
    && echo 'command=php-fpm -F' >> /etc/supervisor/conf.d/supervisord.conf \
    && echo 'autostart=true' >> /etc/supervisor/conf.d/supervisord.conf \
    && echo 'autorestart=true' >> /etc/supervisor/conf.d/supervisord.conf \
    && echo '[program:nginx]' >> /etc/supervisor/conf.d/supervisord.conf \
    && echo 'command=nginx -g "daemon off;"' >> /etc/supervisor/conf.d/supervisord.conf \
    && echo 'autostart=true' >> /etc/supervisor/conf.d/supervisord.conf \
    && echo 'autorestart=true' >> /etc/supervisor/conf.d/supervisord.conf

# Set permissions
RUN chown -R www-data:www-data /var/www/html

EXPOSE 80

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]