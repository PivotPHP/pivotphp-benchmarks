{
    "name": "pivotphp/ecosystem-validation",
    "description": "PivotPHP Ecosystem Comprehensive Validation - Phase 3",
    "type": "project",
    "version": "1.1.4",
    "keywords": ["pivotphp", "benchmark", "ecosystem", "reactphp", "cycle-orm", "performance", "validation"],
    "license": "MIT",
    "authors": [
        {
            "name": "PivotPHP Team",
            "email": "team@pivotphp.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "pivotphp/core": "^1.1.4",
        "pivotphp/reactphp": "^0.1.0",
        "pivotphp/cycle-orm": "^1.0.1",
        "guzzlehttp/guzzle": "^7.0",
        "monolog/monolog": "^3.0",
        "symfony/console": "^6.0",
        "symfony/process": "^6.0",
        "league/csv": "^9.0",
        "vlucas/phpdotenv": "^5.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.8",
        "squizlabs/php_codesniffer": "^3.7",
        "phpunit/phpunit": "^10.0",
        "vimeo/psalm": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "PivotPHP\\EcosystemValidation\\": "src/",
            "PivotPHP\\EcosystemValidation\\Benchmarks\\": "benchmarks/",
            "PivotPHP\\EcosystemValidation\\Tests\\": "tests/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "PivotPHP\\EcosystemValidation\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pivotphp/core": true,
            "pivotphp/reactphp": true,
            "pivotphp/cycle-orm": true
        },
        "platform": {
            "php": "8.1"
        }
    },
    "scripts": {
        "ecosystem-validate": "php run-ecosystem-validation.php",
        "benchmark": "php ecosystem-comprehensive-benchmark.php",
        "stress-test": "docker run --rm -i grafana/k6:latest run /scripts/ecosystem-stress-test.js",
        "docker-up": "docker-compose -f docker-compose-ecosystem.yml up -d",
        "docker-down": "docker-compose -f docker-compose-ecosystem.yml down",
        "docker-build": "docker-compose -f docker-compose-ecosystem.yml build",
        "health-check": "php -r \"echo 'Health check script would go here\\n';\"",
        "setup": "make setup",
        "clean": "make clean",
        "test": "phpunit tests/",
        "phpstan": "phpstan analyse src/ --level=8",
        "cs-check": "phpcs src/ --standard=PSR12",
        "cs-fix": "phpcbf src/ --standard=PSR12",
        "post-install-cmd": [
            "echo '🚀 PivotPHP Ecosystem Validation installed successfully!'",
            "echo '📊 Run: composer ecosystem-validate'"
        ],
        "post-update-cmd": [
            "echo '✅ PivotPHP Ecosystem Validation updated successfully!'"
        ]
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../../pivotphp-core"
        },
        {
            "type": "path",
            "url": "../../../pivotphp-reactphp"
        },
        {
            "type": "path",
            "url": "../../../pivotphp-cycle-orm"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "pivotphp": {
            "ecosystem": {
                "core": "^1.1.4",
                "reactphp": "^0.1.0",
                "cycle-orm": "^1.0.1"
            }
        }
    }
}