{
    "name": "pivotphp/benchmark-phase3-slim4",
    "description": "Benchmarks Comparativos PivotPHP vs Slim 4 - Fase 3",
    "type": "project",
    "require": {
        "php": "^8.1",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.0",
        "guzzlehttp/guzzle": "^7.0",
        "monolog/monolog": "^3.0",
        "doctrine/dbal": "^3.0",
        "predis/predis": "^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.8",
        "squizlabs/php_codesniffer": "^3.7",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "PivotPHP\\Benchmark\\Phase3\\": "src/",
            "PivotPHP\\Benchmark\\Phase3\\Slim4\\": "src/slim4/",
            "PivotPHP\\Benchmark\\Shared\\": "../shared/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "slim/slim": true
        }
    },
    "scripts": {
        "benchmark": "php benchmarks/run-phase3.php",
        "comparative": "php benchmarks/comparative-analysis.php",
        "test": "phpunit tests/",
        "serve-slim4": "php -S localhost:8084 -t src/slim4/public/"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}