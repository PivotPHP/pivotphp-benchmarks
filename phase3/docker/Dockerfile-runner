# Dockerfile para Benchmark Runner - Phase 3
# Executor de benchmarks cross-framework

FROM php:8.2-cli

# Instalar dependências
RUN apt-get update && apt-get install -y \
    curl \
    zip \
    unzip \
    git \
    libicu-dev \
    libzip-dev \
    && rm -rf /var/lib/apt/lists/*

# Instalar extensões PHP
RUN docker-php-ext-install \
    intl \
    zip \
    opcache

# Configurar OPcache para CLI
RUN { \
    echo 'opcache.enable=1'; \
    echo 'opcache.enable_cli=1'; \
    echo 'opcache.jit=1255'; \
    echo 'opcache.jit_buffer_size=128M'; \
    echo 'opcache.memory_consumption=256M'; \
    echo 'opcache.max_accelerated_files=10000'; \
    echo 'opcache.validate_timestamps=0'; \
    echo 'opcache.save_comments=0'; \
} > /usr/local/etc/php/conf.d/opcache.ini

# Configurar PHP
RUN { \
    echo 'memory_limit=1G'; \
    echo 'max_execution_time=0'; \
    echo 'date.timezone=UTC'; \
    echo 'display_errors=Off'; \
    echo 'log_errors=On'; \
} > /usr/local/etc/php/conf.d/cli.ini

# Instalar Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Definir diretório de trabalho
WORKDIR /app

# Copiar dependências
COPY composer.json ./

# Instalar dependências
RUN composer install --no-dev --optimize-autoloader --no-interaction

# Criar diretórios
RUN mkdir -p \
    /app/results \
    /app/logs \
    /app/cache

# Variáveis de ambiente
ENV BENCHMARK_PHASE=3
ENV BENCHMARK_ITERATIONS=200
ENV BENCHMARK_WARMUP=50

# Labels
LABEL maintainer="PivotPHP Team"
LABEL description="Benchmark Runner for Phase 3"
LABEL phase="3"

# Comando padrão
CMD ["tail", "-f", "/dev/null"]