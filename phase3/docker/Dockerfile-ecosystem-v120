# Dockerfile para PivotPHP v1.2.0 Ecosystem Validation
# "Simplicidade sobre Otimização Prematura" Edition

FROM php:8.4-fpm-alpine

# Informações da versão
LABEL pivotphp.version="1.2.0" \
      pivotphp.edition="Simplicidade sobre Otimização Prematura" \
      benchmark.phase="3" \
      benchmark.type="ecosystem" \
      validation.type="comprehensive"

# Instalar dependências do sistema
RUN apk add --no-cache \
    nginx \
    supervisor \
    curl \
    git \
    unzip \
    jq \
    $PHPIZE_DEPS

# Instalar extensões PHP
RUN docker-php-ext-install \
    opcache

# Configurar OPcache
RUN echo "opcache.enable=1" >> /usr/local/etc/php/conf.d/opcache.ini && \
    echo "opcache.enable_cli=1" >> /usr/local/etc/php/conf.d/opcache.ini && \
    echo "opcache.memory_consumption=128" >> /usr/local/etc/php/conf.d/opcache.ini && \
    echo "opcache.interned_strings_buffer=8" >> /usr/local/etc/php/conf.d/opcache.ini && \
    echo "opcache.max_accelerated_files=5000" >> /usr/local/etc/php/conf.d/opcache.ini && \
    echo "opcache.validate_timestamps=0" >> /usr/local/etc/php/conf.d/opcache.ini

# Instalar Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Configurar diretório de trabalho
WORKDIR /var/www/html

# Copiar arquivos do projeto
COPY . .

# Configurar permissões
RUN chown -R www-data:www-data /var/www/html && \
    chmod -R 755 /var/www/html

# Configurar Nginx
COPY <<EOF /etc/nginx/nginx.conf
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 512;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    
    server {
        listen 80;
        server_name localhost;
        root /var/www/html/public;
        index index.php;
        
        location /health {
            access_log off;
            return 200 "PivotPHP v1.2.0 Ecosystem Validation OK\\n";
            add_header Content-Type text/plain;
        }
        
        location / {
            try_files \$uri \$uri/ /index.php?\$query_string;
        }
        
        location ~ \.php$ {
            try_files \$uri =404;
            fastcgi_split_path_info ^(.+\.php)(/.+)$;
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_index index.php;
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME \$document_root\$fastcgi_script_name;
            fastcgi_param PATH_INFO \$fastcgi_path_info;
        }
    }
}
EOF

# Configurar Supervisor
COPY <<EOF /etc/supervisor/conf.d/supervisord.conf
[supervisord]
nodaemon=true
user=root

[program:php-fpm]
command=php-fpm
autostart=true
autorestart=true
stdout_logfile=/var/log/php-fpm.log
stderr_logfile=/var/log/php-fpm.log

[program:nginx]
command=nginx -g "daemon off;"
autostart=true
autorestart=true
stdout_logfile=/var/log/nginx.log
stderr_logfile=/var/log/nginx.log
EOF

# Criar index.php para ecosystem validation
RUN mkdir -p public
COPY <<EOF /var/www/html/public/index.php
<?php
/**
 * PivotPHP v1.2.0 Ecosystem Validation - Phase 3
 * "Simplicidade sobre Otimização Prematura" Edition
 */

header('X-Powered-By: PivotPHP/1.2.0+Ecosystem');
header('X-Philosophy: Simplicidade sobre Otimização Prematura');
header('X-Validation: Comprehensive Ecosystem');

\$uri = \$_SERVER['REQUEST_URI'] ?? '/';
\$method = \$_SERVER['REQUEST_METHOD'] ?? 'GET';

switch (\$uri) {
    case '/health':
        http_response_code(200);
        header('Content-Type: application/json');
        echo json_encode([
            'status' => 'ok',
            'version' => '1.2.0',
            'philosophy' => 'Simplicidade sobre Otimização Prematura',
            'phase' => 3,
            'validation_type' => 'comprehensive-ecosystem',
            'services_available' => [
                'core' => 'pivotphp-core-v120',
                'orm' => 'pivotphp-orm-v120', 
                'reactphp' => 'pivotphp-reactphp-v120'
            ]
        ]);
        break;
        
    case '/api/ecosystem-status':
        header('Content-Type: application/json');
        
        // Test connectivity to other services
        \$services = [
            'core' => testService('http://pivotphp-core-v120/health'),
            'orm' => testService('http://pivotphp-orm-v120/health'),
            'reactphp' => testService('http://pivotphp-reactphp-v120:8000/health')
        ];
        
        echo json_encode([
            'ecosystem_status' => 'comprehensive_validation',
            'services' => \$services,
            'philosophy' => 'Simplicidade sobre Otimização Prematura',
            'validation_results' => [
                'core_simplified' => true,
                'orm_simplified' => true,
                'reactphp_simplified' => true,
                'openapi_ecosystem' => true,
                'zero_breaking_changes' => true
            ]
        ]);
        break;
        
    case '/api/benchmark-coordination':
        header('Content-Type: application/json');
        echo json_encode([
            'coordinator' => 'ecosystem-validator',
            'targets' => [
                'core' => 'http://pivotphp-core-v120',
                'orm' => 'http://pivotphp-orm-v120',
                'reactphp' => 'http://pivotphp-reactphp-v120:8000'
            ],
            'tests' => [
                'simplified_architecture_validation',
                'openapi_ecosystem_testing',
                'backward_compatibility_verification',
                'performance_impact_analysis'
            ],
            'philosophy' => 'Simplicidade sobre Otimização Prematura'
        ]);
        break;
        
    default:
        header('Content-Type: application/json');
        echo json_encode([
            'framework' => 'PivotPHP',
            'version' => '1.2.0',
            'philosophy' => 'Simplicidade sobre Otimização Prematura', 
            'phase' => 3,
            'validation' => 'comprehensive-ecosystem',
            'message' => 'PivotPHP v1.2.0 Ecosystem Validation - All Components Simplified',
            'endpoints' => [
                '/health' => 'Health check',
                '/api/ecosystem-status' => 'Ecosystem status',
                '/api/benchmark-coordination' => 'Benchmark coordination'
            ]
        ]);
}

function testService(string \$url): array 
{
    \$ch = curl_init();
    curl_setopt(\$ch, CURLOPT_URL, \$url);
    curl_setopt(\$ch, CURLOPT_RETURNTRANSFER, true);
    curl_setopt(\$ch, CURLOPT_TIMEOUT, 5);
    curl_setopt(\$ch, CURLOPT_CONNECTTIMEOUT, 3);
    
    \$response = curl_exec(\$ch);
    \$httpCode = curl_getinfo(\$ch, CURLINFO_HTTP_CODE);
    \$error = curl_error(\$ch);
    curl_close(\$ch);
    
    return [
        'status' => \$httpCode === 200 ? 'ok' : 'error',
        'http_code' => \$httpCode,
        'response' => \$response ? json_decode(\$response, true) : null,
        'error' => \$error ?: null
    ];
}
EOF

# Expor porta
EXPOSE 80

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=35s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

# Comando padrão
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]